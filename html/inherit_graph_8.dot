digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="Dominio",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_dominio.html",tooltip="Classe base abstrata para todos os domínios do sistema."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="Codigo",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_codigo.html",tooltip="Domínio para identificadores alfanuméricos com formato fixo de 5 caracteres."];
  Node0 -> Node2 [id="edge2_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Data",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_data.html",tooltip="Domínio para representar um ponto específico no calendário gregoriano."];
  Node0 -> Node3 [id="edge3_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="Estado",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_estado.html",tooltip="Representa em qual etapa do fluxo de trabalho uma tarefa se encontra."];
}
