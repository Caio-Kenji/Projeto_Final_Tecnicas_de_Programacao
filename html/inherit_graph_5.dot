  rankdir="LR";
  Node0 [id="Node000000",label="Dominio",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classDominio.html",tooltip="Classe base abstrata para todos os domínios do sistema."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
